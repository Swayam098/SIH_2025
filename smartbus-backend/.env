SUPABASE_URL=
SUPABASE_KEY=
BACKEND_URL=http://localhost:5000   # your Express backend URL (no trailing slash)
USE_SUPABASE_DIRECT=false           # true => write 'locations' directly to Supabase instead of POSTing to backend
UPDATE_INTERVAL_MS=5000             # how often to send updates (ms)
SPEED_KMH=20                        # simulated average speed
LOOP=true                           # whether to loop the route when finished
TRANSLATE_PROVIDER=libre      # or 'google' if you want to use Google Translate
TRANSLATE_API_URL=https://libretranslate.com/translate